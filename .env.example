# Порт, на котором будет доступен сайт
INEGO_PORT=8080
# true — мок-генерация в браузере, false — через backend/ComfyUI
VITE_USE_MOCK=true
# Порт бэкенда на localhost (для npm run dev)
BACKEND_PORT=8010
# Адрес ComfyUI (из контейнера backend). ComfyUI на хосте: http://host.docker.internal:8188
COMFYUI_URL=http://comfyui:8188
# Токен Hugging Face для FLUX.2 klein 9B (gated, некоммерческая лицензия BFL):
# примите условия на https://huggingface.co/black-forest-labs/FLUX.2-klein-9b-fp8
# Пусто — ComfyUI скачает только klein 4B
HF_TOKEN=

# База данных
POSTGRES_PASSWORD=inego

# Секрет для подписи сессий. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# true, если сайт работает по HTTPS
COOKIE_SECURE=false

# DeepSeek — описание исходника и сборка промпта (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Модель по умолчанию и список для переключателя Flash / Pro в шапке сайта
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
