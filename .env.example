# Порт, на котором будет доступен сайт
INEGO_PORT=8080
# true — мок-генерация в браузере, false — через backend/ComfyUI
VITE_USE_MOCK=true
# Порт бэкенда на localhost (для npm run dev)
BACKEND_PORT=8010
# Адрес ComfyUI (из контейнера backend). ComfyUI на хосте: http://host.docker.internal:8188
COMFYUI_URL=http://comfyui:8188

# База данных
POSTGRES_PASSWORD=inego

# Секрет для подписи сессий. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# true, если сайт работает по HTTPS
COOKIE_SECURE=false

# DeepSeek — описание исходника и сборка промпта (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
